# AirBrief configuration. Copy to `.env` (cp .env.example .env). The defaults work as-is for a
# native local run: SQLite database, files under ./data, in-process job worker.
# Every value below is read by api/config.py (pydantic-settings). See docs/SPEC.md §4.

# ---- Application -----------------------------------------------------------------------------
# development | production  (production turns off debug output and requires explicit CORS_ORIGINS)
# production also turns on the safe defaults below: owner tokens, scoped listings, 72 h retention,
# storage quota, job time limit, queued uploads, HSTS, and /docs off.
# development answers only clients on this machine or a private network (403 for public addresses).
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---- Database ----------------------------------------------------------------------------------
# Default: a SQLite file, no server needed.
DATABASE_URL=sqlite:///./data/airbrief.db
# PostgreSQL (optional): pip install -e ".[api,postgres]", then for example
# DATABASE_URL=postgresql+psycopg://airbrief:CHANGE_ME@localhost:5432/airbrief
# (CHANGE_ME stands for the database password: use a long random one, never this text.)
# Run Alembic migrations automatically when the API starts (true | false).
AUTO_MIGRATE=true

# ---- Storage -----------------------------------------------------------------------------------
# Root for runtime data. UPLOAD_DIR and DATAPACK_DIR normally live inside it.
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
DATAPACK_DIR=./data/datapacks
# Data pack to prefer when several cover the inputs (e.g. demo or bengaluru).
# Empty = real packs before the synthetic demo, then the most specific one.
DEFAULT_DATAPACK=
# Total size of UPLOAD_DIR in MB; uploads past it get 507 storage_full.
# Empty = unlimited in development, 5000 when APP_ENV=production; 0 = unlimited.
STORAGE_QUOTA_MB=
# Upload MB one client address may send in 24 hours (429 upload_budget_exceeded past it).
# Empty = unlimited in development, 1000 when APP_ENV=production; 0 = unlimited.
UPLOAD_MB_PER_DAY=
# Refuse uploads (507) while the disk under UPLOAD_DIR has less than this free. 0 = off.
MIN_FREE_DISK_MB=500

# ---- Upload limits -----------------------------------------------------------------------------
# Maximum upload size (413 above this).
MAX_UPLOAD_MB=50
# Size limit for any other POST body (JSON analysis requests, inline FlightMD reports)
MAX_JSON_BODY_MB=10
# Zip-bomb guard: maximum total uncompressed size of an archive.
MAX_UNZIPPED_MB=200
# Maximum number of entries in an archive.
MAX_ARCHIVE_FILES=200
# Maximum number of features read from one upload.
MAX_FEATURES=50000
# Total vertices per file (guards CPU-heavy geometry repair and measurement)
MAX_COORDINATES=5000000
# Uploads up to this size are processed inside the request (201); larger ones are queued (202).
# Empty = 5 in development, 0 when APP_ENV=production (every upload is queued).
INLINE_PROCESS_MAX_MB=

# ---- Jobs --------------------------------------------------------------------------------------
# inprocess: the API runs jobs on its own thread pool.
# external:  the API only queues jobs; run `python -m api.worker` to process them.
JOB_MODE=inprocess
# Job threads per process (the API in inprocess mode, or each worker).
WORKER_THREADS=2
# Seconds an idle job runner waits before it looks for new jobs again (default 1).
# WORKER_POLL_INTERVAL_S=1
# Seconds one analysis may run before it is stopped (FAILED job_timeout).
# Empty = no limit in development, 900 when APP_ENV=production; 0 = no limit.
JOB_TIMEOUT_S=
# Address-space limit of `python -m api.worker` in MB (Linux/macOS only). Empty = off.
WORKER_MEMORY_LIMIT_MB=

# ---- HTTP --------------------------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API. POST/DELETE requests that carry any
# other Origin header are refused (403 cross_site_request). When the app and the API share one
# domain, list that domain too: browsers send Origin on same-origin POSTs.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Per-IP limit on POST and DELETE endpoints (uploads, analyses, deletes); IPv6 counts per /64.
# 0 = unlimited.
RATE_LIMIT_PER_HOUR=120
# Per-IP limit on GET /api/context/ and /api/places/ (context layers, place search) together.
# Empty = unlimited in development, 3600 when APP_ENV=production; 0 = unlimited.
CONTEXT_RATE_LIMIT_PER_HOUR=
# Per-IP limit on every other GET under /api/ (results, exports, listings, job polling).
# Empty = unlimited in development, 36000 when APP_ENV=production; 0 = unlimited.
READ_RATE_LIMIT_PER_HOUR=
# Proxies in front of the API that append to X-Forwarded-For (rate-limit key = the client address
# the outermost one saw). 0 = the peer address: right for Caddy/nginx on the same machine.
# Render: 1. Only set it when the API is reachable ONLY through those proxies.
TRUSTED_PROXY_HOPS=0
# Delete uploads and their analyses after N hours; 0 = keep forever (the default in development).
# When APP_ENV=production and this stays unset, uploads are deleted after 72 h.
# UPLOAD_TTL_HOURS=24
# List every dataset/analysis on the server (true/false). Empty = allowed except when APP_ENV=production;
# when disabled, each browser lists only the ids it created.
ALLOW_GLOBAL_LISTING=
# Deleting/cancelling needs the item's owner token (X-Owner-Token), which only the creating browser has.
# Empty = on when APP_ENV=production.
# When on, ?dataset_id= lists only the analyses run with the dataset's owner token (plus ?ids=).
REQUIRE_OWNER_TOKEN=
# API docs pages /docs and /redoc (true/false). They load Swagger UI and ReDoc from cdn.jsdelivr.net
# (pinned versions). Empty = on in development, off when APP_ENV=production. /openapi.json stays.
API_DOCS=
# Host names the API answers to, comma-separated (e.g. airbrief.example.com,127.0.0.1); any other
# Host header gets 400. Empty = any host. List 127.0.0.1 too if a local health check calls the API.
ALLOWED_HOSTS=

# ---- FlightMD integration (optional) -----------------------------------------------------------
# Default FlightMD API used by the flight audit's "fetch by URL"; users can override it in Settings.
# A base URL only (no user name, password, ?query or #fragment). Only {URL}/report/{id} is fetched
# from its host, and /api/meta/ shows just its scheme and host.
FLIGHTMD_API_URL=
# Seconds per request of a report fetch (each of the at most 3 redirects gets its own).
FLIGHTMD_FETCH_TIMEOUT_S=15

# ---- Briefs (optional) -------------------------------------------------------------------------
# PEM Ed25519 private key that signs every brief bundle (signature.json); create one with
# python -m airbrief_core.verify --new-key <path> and keep it out of the repository.
# Empty = bundles are not signed: their hashes then detect corruption, not deliberate edits.
BRIEF_SIGNING_KEY_FILE=

# ---- Frontend (read by Next.js from frontend/.env.local; listed here for reference) ------------
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_BASEMAP=openfreemap
# NEXT_PUBLIC_DEMO=0
# NEXT_PUBLIC_BASE_PATH=
# NEXT_OUTPUT=
