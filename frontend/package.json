{
  "name": "airbrief-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "AirBrief web app: geospatial pre-flight evidence workspace for drones and eVTOL (Next.js 15).",
  "license": "MIT",
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "cross-env NEXT_TELEMETRY_DISABLED=1 next dev",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "cross-env NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "cross-env NEXT_TELEMETRY_DISABLED=1 next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.mjs --max-warnings=0",
    "typecheck": "cross-env NEXT_TELEMETRY_DISABLED=1 next typegen && tsc --noEmit",
    "e2e": "playwright test",
    "preexport": "node scripts/copy-maplibre-worker.mjs",
    "export": "cross-env NEXT_OUTPUT=export NEXT_TELEMETRY_DISABLED=1 next build"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.1",
    "@deck.gl/extensions": "^9.4.1",
    "@deck.gl/geo-layers": "^9.4.1",
    "@deck.gl/layers": "^9.4.1",
    "@deck.gl/mapbox": "^9.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-virtual": "^3.14.26",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "geist": "^1.9.2",
    "h3-js": "^4.1.0",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "^6.17.0",
    "next": "^15.5.29",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^2.12.7",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.5.4",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^20.16.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.18"
  },
  "overrides": {
    "postcss": "$postcss",
    "fflate": "^0.8.2",
    "image-size": "^2.0.4",
    "argparse": "^2.0.1"
  }
}
