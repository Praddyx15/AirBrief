# Base URL of the AirBrief API (FastAPI). No trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Default basemap: "openfreemap" (vector tiles, no key) or "none" (offline, data only).
NEXT_PUBLIC_BASEMAP=openfreemap

# 1 = static demo mode: the API client reads pre-built JSON from ${NEXT_PUBLIC_BASE_PATH}/demo/
# (generated by `python -m seed.demo_export --out frontend/public/demo`). Mutations are disabled.
NEXT_PUBLIC_DEMO=0

# Serve the app under a sub-path, e.g. /airbrief for GitHub Pages. Empty = domain root.
NEXT_PUBLIC_BASE_PATH=
